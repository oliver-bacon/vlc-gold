import QtQuick

import VLC.Style

// read-only text that can be selected and copied
TextEdit {
    readOnly: true
    selectByMouse: true
    textFormat: TextEdit.PlainText
    color: WinStyle.strongText
    selectionColor: WinStyle.selected
    selectedTextColor: WinStyle.strongText
    font.pixelSize: VLCStyle.fontSize_large
    clip: true
}
